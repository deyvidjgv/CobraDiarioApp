rules_version = '2';

// Modelo multitenant con roles (Plan Maestro, Fase 2):
//
// userIndex/{uid} -> { organizationId, role }
//   Mapeo minimo para que cualquier usuario (admin o cobradiario) sepa a
//   que organizacion pertenece y con que rol, sin depender de que su uid
//   sea el propio orgId.
//
// organizations/{orgId}
//   ├─ users/{uid}          ficha de cada miembro (role, estado)
//   ├─ settings              configuracion administrativa (un doc)
//   ├─ clients/{clientId}    cobradiarioId identifica al dueño operativo
//   ├─ loans/{loanId}        cobradiarioId identifica al dueño operativo
//   ├─ movements/{movementId} cobradiarioId identifica al dueño operativo
//   └─ daily_closings/{fecha}
//
// Regla de negocio (seccion 10 del plan maestro): un cobradiario puede
// crear/leer sus propios registros operativos, pero no puede editar ni
// borrar movimientos financieros ya creados. Esa capacidad queda
// reservada al Admin (correcciones se resuelven por flujo aparte, Fase 7).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(orgId, uid) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/users/$(uid)).data;
    }

    function isActiveMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid))
        && memberDoc(orgId, request.auth.uid).estado == "activo";
    }

    function isAdminOf(orgId) {
      return isActiveMember(orgId) && memberDoc(orgId, request.auth.uid).role == "admin";
    }

    function isCobradiarioOf(orgId) {
      return isActiveMember(orgId) && memberDoc(orgId, request.auth.uid).role == "cobradiario";
    }

    function ownsRecord(data) {
      return data.cobradiarioId == request.auth.uid;
    }

    // Congela las condiciones sensibles del vencimiento: el cobradiario
    // solo puede mover recargosAcumulados/fechaUltimoRecargo/continuacion.
    function vencimientoCongelado(before, after) {
      return (before == null && after == null)
        || (before != null && after != null
            && after.porcentaje == before.porcentaje
            && after.activo == before.activo
            && after.proximoCorte == before.proximoCorte
            && after.modoInicial == before.modoInicial
            && after.fechaVencimientoTotal == before.fechaVencimientoTotal);
    }

    // userIndex/{uid}: mapeo uid -> organizationId/role.
    // El propio usuario puede leer su indice. La creacion se permite en
    // dos casos: (1) auto-bootstrap, un usuario creandose a si mismo como
    // admin de su propia organizacion (ver AuthContext); (2) un admin
    // activo registrando a un cobradiario que acaba de crear en Firebase
    // Auth (ver secondaryAuth.js — no hay backend, Fase 3 corre 100% en
    // el cliente). Como es "create" y no "update", nunca puede pisar un
    // userIndex ya existente.
    match /userIndex/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.organizationId == uid
                    && request.resource.data.role == "admin";
      allow create: if request.resource.data.role == "cobradiario"
                    && isAdminOf(request.resource.data.organizationId);
      allow update, delete: if false;
    }

    match /organizations/{orgId} {
      allow read, write: if isAdminOf(orgId);

      match /users/{userId} {
        allow read: if isAdminOf(orgId) || (isSignedIn() && request.auth.uid == userId);
        // Auto-bootstrap (un usuario se registra como admin de su propia org).
        allow create: if isSignedIn() && request.auth.uid == userId
                      && userId == orgId && orgId == request.auth.uid
                      && request.resource.data.role == "admin";
        // El Admin registra a un cobradiario que acaba de crear en Auth.
        allow create: if isAdminOf(orgId) && request.resource.data.role == "cobradiario";
        // El Admin puede activar/desactivar o editar la ficha de un miembro.
        allow update: if isAdminOf(orgId);
        allow delete: if false;
      }

      match /settings/{docId} {
        allow read: if isActiveMember(orgId);
        allow write: if isAdminOf(orgId);
      }

      match /clients/{clientId} {
        allow read: if isAdminOf(orgId) || (isCobradiarioOf(orgId) && ownsRecord(resource.data));
        allow create: if isAdminOf(orgId)
                      || (isCobradiarioOf(orgId) && ownsRecord(request.resource.data));
        allow update: if isAdminOf(orgId)
                      || (isCobradiarioOf(orgId) && ownsRecord(resource.data) && ownsRecord(request.resource.data));
        allow delete: if isAdminOf(orgId);
      }

      match /loans/{loanId} {
        allow read: if isAdminOf(orgId) || (isCobradiarioOf(orgId) && ownsRecord(resource.data));
        allow create: if isAdminOf(orgId)
                      || (isCobradiarioOf(orgId) && ownsRecord(request.resource.data));
        // Condiciones del credito CONGELADAS: el cobradiario dueno solo
        // puede tocar los campos del ciclo de pago (saldo/estado/recargos
        // que fluyen al registrar un cobro o aplicar un recargo). Capital,
        // interes, cuotas, frecuencia, fecha de inicio, cliente y dueno
        // nunca son modificables por el — solo el Admin puede cambiarlos.
        allow update: if isAdminOf(orgId)
                      || (isCobradiarioOf(orgId)
                          && ownsRecord(resource.data)
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["saldoPendiente", "estado", "montoTotalAPagar",
                                       "vencimiento", "updatedAt"])
                          && (request.resource.data.estado == resource.data.estado
                              || request.resource.data.estado == "completado")
                          && vencimientoCongelado(resource.data.vencimiento,
                                                  request.resource.data.vencimiento));
        allow delete: if isAdminOf(orgId);
      }

      match /movements/{movementId} {
        allow read: if isAdminOf(orgId) || (isCobradiarioOf(orgId) && ownsRecord(resource.data));
        allow create: if isAdminOf(orgId)
                      || (isCobradiarioOf(orgId) && ownsRecord(request.resource.data));
        // Inmutabilidad financiera: solo el Admin corrige/anula movimientos.
        allow update, delete: if isAdminOf(orgId);
      }

      match /daily_closings/{fecha} {
        allow read: if isActiveMember(orgId);
        allow write: if isAdminOf(orgId);
      }

      // Solicitudes de corrección (Fase 7, seccion 11 del plan maestro):
      // un cobro/movimiento no se edita ni se borra directamente, se pide
      // una correccion que el Admin aprueba o rechaza. El original nunca
      // se toca; la aprobacion crea un movimiento de ajuste aparte
      // (ver useCorrections.js) y deja trazabilidad completa.
      match /correctionRequests/{reqId} {
        allow read: if isAdminOf(orgId)
                    || (isSignedIn() && resource.data.createdBy == request.auth.uid);
        allow create: if request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.estado == "pendiente"
                      && (isAdminOf(orgId) || isCobradiarioOf(orgId));
        // Solo el Admin resuelve (aprueba/rechaza) una solicitud.
        allow update: if isAdminOf(orgId) && resource.data.estado == "pendiente";
        allow delete: if false;
      }

      // Visitas de ruta (Fase 8): cada gestion presencial queda registrada
      // con GPS y resultado (Plan Maestro, seccion "visits"). Como los
      // movimientos financieros, son inmutables: se crean, no se editan.
      match /visits/{visitId} {
        allow read: if isAdminOf(orgId) || (isCobradiarioOf(orgId) && ownsRecord(resource.data));
        allow create: if isAdminOf(orgId)
                      || (isCobradiarioOf(orgId) && ownsRecord(request.resource.data));
        allow update, delete: if false;
      }

      // Auditoria (Fase 9): append-only, solo el Admin consulta.
      match /auditLogs/{logId} {
        allow read: if isAdminOf(orgId);
        allow create: if isActiveMember(orgId)
                      && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Cualquier otra ruta no listada explicitamente queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
